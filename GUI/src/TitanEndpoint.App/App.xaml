<Application x:Class="TitanEndpoint.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TitanEndpoint.App.Converters">
    <!-- Santosh, 2026-08-31: "add lightmode and darkmode option." Theme.xaml (and, ahead of it, the
         chosen Palette.xaml/PaletteLight.xaml) is no longer merged here declaratively. App.xaml.cs's
         OnStartup merges whichever palette the saved setting selects, then Theme.xaml, into these
         same Resources before the first window is constructed, so every StaticResource lookup below
         and in every page's XAML still resolves exactly as before; only WHICH palette values it
         resolves to changes based on the setting. -->
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>
            <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
            <conv:AppliedToBrushConverter x:Key="AppliedToBrushConverter"/>
            <conv:StageEqualsConverter x:Key="StageEqualsConverter"/>
            <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
            <conv:BoolToOnOffConverter x:Key="BoolToOnOff"/>
            <conv:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
