<UserControl x:Class="TitanEndpoint.App.Controls.RadialGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Ellipse x:Name="Track" Stroke="{StaticResource BorderBrush2}" StrokeThickness="8" Fill="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Path x:Name="Arc" Stroke="{StaticResource AccentBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PercentText" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="CaptionText" HorizontalAlignment="Center" FontSize="10"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
