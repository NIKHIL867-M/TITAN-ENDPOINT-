<UserControl x:Class="TitanEndpoint.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Endpoint Paths" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EndpointSettingsRowViewModel}">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding ExecutableSource}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                                        <TextBox Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsExecutableReadOnly}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Log directory" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                                        <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                        <TextBlock Text="Log file pattern" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                                        <TextBox Text="{Binding LogFilePattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                    <TextBlock Text="Custom Rule data directory" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                    <TextBox Text="{Binding CustomRuleDataDirectory, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2,0,10"
                             AutomationProperties.Name="Custom Rule data directory" AutomationProperties.AutomationId="CustomRuleDataDirectoryTextBox"/>
                    <TextBlock Text="Custom Rule local API URL" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                    <TextBox Text="{Binding CustomRuleApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2,0,10"
                             AutomationProperties.Name="Custom Rule local API URL" AutomationProperties.AutomationId="CustomRuleApiBaseUrlTextBox"/>
                    <TextBlock Text="Global disk budget (GB)" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                    <TextBox Text="{Binding GlobalDiskBudgetGb, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,2,0,0"
                             AutomationProperties.Name="Global disk budget in gigabytes" AutomationProperties.AutomationId="GlobalDiskBudgetTextBox"/>
                    <TextBlock Text="Minimum free-space reserve (GB)" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding MinimumFreeSpaceGb, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,2,0,0"
                             AutomationProperties.Name="Minimum free-space reserve in gigabytes" AutomationProperties.AutomationId="MinimumFreeSpaceTextBox"/>
                    <CheckBox Content="Reduce interface motion and animated transitions" IsChecked="{Binding ReducedMotion}" Margin="0,12,0,0"
                              AutomationProperties.Name="Reduce interface motion and animated transitions" AutomationProperties.AutomationId="ReducedMotionCheckBox"/>
                    <CheckBox Content="Compact table density" IsChecked="{Binding CompactTableDensity}" Margin="0,8,0,0"
                              AutomationProperties.Name="Compact table density" AutomationProperties.AutomationId="CompactTableDensityCheckBox"
                              ToolTip="Applies immediately and persists across restarts -- shorter rows and tighter cell padding across every table in the app."/>
                    <!-- Santosh, 2026-08-31: "just add button on dark and light... no restart for
                         that." The theme toggle moved to the top command bar (always one click away,
                         auto-relaunches TITAN itself, see MainWindow.xaml/App.RestartWithTheme) so it
                         no longer lives here; a second, worse copy of the same setting that still
                         needed a manual restart via this page would just be a confusing duplicate. -->
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
                        MinWidth="120" MinHeight="30" HorizontalAlignment="Left"
                        AutomationProperties.Name="Save settings" AutomationProperties.AutomationId="SaveSettingsButton"/>
                <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource SecondaryTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" TextWrapping="Wrap" Margin="0,16,0,0">
                Settings are validated before being committed and saved atomically with a backup. Manifest-owned executable
                paths are read-only. Collector-specific capture, retention, privacy and response policy remain owned by each
                endpoint configuration until those collectors expose authenticated control channels; this page does not present
                unsupported controls as if they were live.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
