<UserControl x:Class="TitanEndpoint.App.Views.CorrelationGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels"
             xmlns:ctl="clr-namespace:TitanEndpoint.App.Controls"
             xmlns:common="clr-namespace:TitanEndpoint.App.Common">
    <UserControl.DataContext>
        <vm:CorrelationGraphViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="PentagonRow" Height="1.15*" MinHeight="300"/>
            <RowDefinition x:Name="TableSplitterRow"
                           Height="{Binding IsChecked, ElementName=ShowTableToggle, Converter={StaticResource BoolToGridLength}, ConverterParameter=6}"/>
            <RowDefinition x:Name="TableRow" MinHeight="0"
                           Height="{Binding IsChecked, ElementName=ShowTableToggle, Converter={StaticResource BoolToGridLength}, ConverterParameter=1*}"/>
        </Grid.RowDefinitions>

        <ctl:EndpointHeader Grid.Row="0" Header="{Binding Header}"/>

        <!-- Santosh, 2026-08-31: "below table is there, I don't really want that table... give option
             to hide or unhide so only when I wanted it will pop else no." Default unchecked (hidden):
             the merged table only appears on demand; the pentagon row above has no data trigger of
             its own and simply keeps its normal 1.15* share, so with the table's rows collapsed to 0
             it naturally gets the freed space since it is the only remaining non-zero star row. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <!-- Santosh, 2026-08-31 (third pass): "show table button... not working". The toggle
                 itself was always working correctly (confirmed via automation: IsChecked state and
                 the row heights both changed as expected). The actual bug: no CheckBox in this app has
                 an implicit TargetType="CheckBox" style (only the separate, explicitly-referenced
                 ToggleSwitchStyle does), so a plain CheckBox with no explicit Foreground renders its
                 checkmark/label in WPF's stock near-black default, genuinely invisible against this
                 dark theme, confirmed via an actual screenshot (not just automation properties, which
                 don't reflect a rendering-color bug at all). Same root cause class already found and
                 fixed once for MonoTextStyle (Round 26); this is the same issue on a control type that
                 fix never touched, not a functional problem. -->
            <CheckBox x:Name="ShowTableToggle" DockPanel.Dock="Right" Content="Show Correlation Table" IsChecked="False"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      VerticalAlignment="Center" AutomationProperties.AutomationId="ShowCorrelationTableToggle"/>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" AutomationProperties.AutomationId="CorrelationGraphSummaryText"/>
        </DockPanel>

        <!-- Santosh, 2026-08-27: "create another page and put all the incident graph into there."
             The incident list moved out to its own IncidentGraphView, so this page no longer needs
             to split its height between two competing sections; it goes back to one row that gets
             the whole page. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="420"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush2}" ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize flow graph vs per-endpoint summary"/>

            <!-- ===================== LIVE FLOW GRAPH ===================== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Live Endpoint Connection Flow" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="An edge means the Correlator has joined these two endpoints' evidence -- thicker/brighter as real connections accumulate. This is an observed association, not a claimed direction or cause."/>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Click a node to focus on that endpoint, or a connection's count badge to focus on that pair -- everything else dims. Click the same thing again, or Clear Selection below, to clear. The number under each node's dot is that endpoint's live record count."/>
                        <!-- Santosh, 2026-08-31: "in the correlation there are 2 pages... I cannot
                             unselect it, work more on that UI functionality." This page previously had
                             NO clear/status control at all: ShowAllIncidentsCommand and
                             SelectedPairText already existed on this exact ViewModel (used by the
                             separate Incident Graph page, its own independent instance) but were never
                             surfaced here, so the only way to clear a filter was re-clicking the exact
                             element, with zero feedback about what was even selected. Same command,
                             same text, now on this page too. -->
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Clear Selection" Command="{Binding ShowAllIncidentsCommand}" Padding="8,3" FontSize="11"
                                    AutomationProperties.AutomationId="ClearGraphSelectionButton"/>
                            <TextBlock Text="{Binding SelectedPairText}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       AutomationProperties.AutomationId="CorrelationFlowSelectedPairText"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                            <Slider Width="140" Minimum="0.7" Maximum="1.8" Value="{Binding GraphZoom}" TickFrequency="0.1" VerticalAlignment="Center"
                                    AutomationProperties.Name="Zoom the live endpoint connection flow graph"
                                    AutomationProperties.AutomationId="CorrelationFlowGraphZoomSlider"/>
                            <TextBlock Text="{Binding GraphZoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Santosh, 2026-08-27: "we can adjust the size... that is not working." The zoom
                         slider was scaling GraphCanvasRoot via RenderTransform, which is purely a paint-
                         time effect; it never changes what size WPF thinks the Grid is, so this
                         ScrollViewer kept reporting the original unscaled 380x300 as the full extent
                         and clipped anything the scale-up pushed past it, making zooming in above 100%
                         look like it did nothing. LayoutTransform participates in the actual layout
                         pass, so the ScrollViewer now sees (and can scroll to) the real scaled size. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="GraphCanvasRoot" Width="380" Height="300" AutomationProperties.AutomationId="CorrelationFlowGraphCanvas"
                              AutomationProperties.Name="Live endpoint connection flow graph">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding GraphZoom}" ScaleY="{Binding GraphZoom}"/>
                            </Grid.LayoutTransform>
                            <!-- Edges drawn first so node visuals sit on top of each line's endpoint stub.
                                 FlowEdgeControl (Controls/FlowEdgeControl.xaml.cs) owns its own entrance
                                 fade-in and animates thickness/opacity/pulse toward each new Count via
                                 BeginAnimation, mirroring RadialGauge's Reduced-Motion-safe convention,
                                 not plain data-bound values which would only ever snap instantly. Dimmed
                                 likewise animates the whole edge's opacity down when a node/pair filter
                                 elsewhere is active and this edge is not part of it (Round 23). -->
                            <ItemsControl ItemsSource="{Binding Edges}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlowEdgeViewModel}">
                                        <ctl:FlowEdgeControl Width="380" Height="300"
                                                              X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                              Count="{Binding Count}" CountText="{Binding CountText}" ToolTipText="{Binding ToolTipText}"
                                                              Dimmed="{Binding IsDimmed}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Nodes}" AutomationProperties.AutomationId="CorrelationFlowGraphNodesList">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <!-- Round 23: a node used to be a plain, non-interactive Border;
                                         now a Button carrying the exact same visual (custom
                                         ControlTemplate) so it gains Command/hover/keyboard focus for
                                         free, the same technique CorrelationView's Evidence Graph tab
                                         already uses for ITS nodes (see CorrelationView.xaml). -->
                                    <DataTemplate DataType="{x:Type vm:FlowNodeViewModel}">
                                        <Button Width="{Binding Size}" Height="{Binding Size}" Command="{Binding SelectCommand}"
                                                Opacity="{Binding DisplayOpacity}" Cursor="Hand" Background="Transparent"
                                                BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                                                ToolTip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label, StringFormat=Endpoint flow node: {0}. Click to filter incidents to this endpoint.}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="NodeBorder" CornerRadius="36"
                                                            Background="{StaticResource PanelBg2Brush}"
                                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Width="58"/>
                                                            <Ellipse Width="7" Height="7" Margin="0,3,0,0" Fill="{Binding DotBrush}"/>
                                                            <TextBlock Text="{Binding RecordsSeenText}" HorizontalAlignment="Center" FontSize="8.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="NodeBorder" Property="Background" Value="{StaticResource AccentBrushSoft}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="3.5"/>
                                                            <Setter TargetName="NodeBorder" Property="Background" Value="{StaticResource AccentBrushSoft}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===================== PER-ENDPOINT SUMMARY ===================== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Per-Endpoint Summary" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding SummaryRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              AutomationProperties.Name="Per-endpoint live flow summary"
                              AutomationProperties.AutomationId="CorrelationFlowSummaryGrid"
                              common:LayoutPersistence.GridKey="CorrelationFlowSummaryGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Label}" Width="1.1*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding LiveText}" Width="0.8*"/>
                            <DataGridTextColumn Header="Records Seen" Binding="{Binding RecordsSeen, StringFormat=N0}" Width="1*"/>
                            <DataGridTextColumn Header="Cross-Links" Binding="{Binding CrossLinks, StringFormat=N0}" Width="0.9*"/>
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenText}" Width="0.9*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrush2}"
                      common:LayoutPersistence.SplitterKey="CorrelationGraphMerged"/>

        <!-- ===================== MERGED: COMPACT CORRELATION TABLE ===================== -->
        <!-- Santosh, 2026-08-31: "in the correlation there are 2 pages, correlation and correlation
             graph... I want correlation graph but not correlation... merge these 2 pages into 1 and
             then correlation table u make into small table." The full-page Correlation grid+4-tab
             investigation view moved here as-is (same CorrelationViewModel, unchanged: this Grid
             scopes its own DataContext locally so the outer page keeps binding to
             CorrelationGraphViewModel above), just narrower (fewer, more essential columns: what
             happened / which sources / connection state, not every count column) and collapsed by
             default under an Expander so the pentagon still gets most of the page's height, matching
             "small table". Full investigation detail (Timeline/Evidence Graph/Chain View/Raw JSON)
             is one click away on a selected row, not removed. -->
        <!-- Santosh, 2026-08-31 (second pass): "show table only button... it is not working." Live-
             tested and traced further: the RowDefinition Height binding (via BoolToGridLength) was
             actually collapsing to 0 correctly (confirmed: the Expander inside went from an empty
             BoundingRectangle to a real one on toggle), but Grid does NOT clip its children to its
             own bounds by default, so the DataGrid below, given a MaxHeight far larger than the
             collapsed 0px row, simply kept rendering at its own natural size, overlapping whatever
             was underneath instead of actually disappearing. ClipToBounds makes this section respect
             its allocated height (real 0 when hidden) instead of overflowing past it. -->
        <Grid Grid.Row="4" ClipToBounds="True">
            <Grid.DataContext>
                <vm:CorrelationViewModel/>
            </Grid.DataContext>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="Correlation Table" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"
                         ToolTip="Filter by correlation ID, involved sources, time span or connection state"
                         AutomationProperties.Name="Filter unified correlation events"
                         AutomationProperties.AutomationId="CorrelationFilterTextBox"/>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" MaxHeight="150" FontSize="11"
                      AutomationProperties.Name="Unified correlation events"
                      AutomationProperties.AutomationId="CorrelationGroupsGrid"
                      common:LayoutPersistence.GridKey="CorrelationGroupsGridCompact">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding GroupId, StringFormat=corr-{0}}" Width="80"/>
                    <DataGridTextColumn Header="Sources" Binding="{Binding Endpoints}" Width="1.1*"/>
                    <DataGridTextColumn Header="What Happened" Binding="{Binding PrimarySubjectText}" Width="1.6*"/>
                    <DataGridTextColumn Header="Connection" Binding="{Binding MissingEndpointsText}" Width="1.3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Expander Grid.Row="2" Header="Investigation Detail" IsExpanded="False" Margin="0,4,0,0"
                      AutomationProperties.AutomationId="CorrelationInvestigationExpander">
                <Border Style="{StaticResource CardStyle}" MaxHeight="360" Margin="0,4,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectedGroup.MissingEndpointsText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="CorrelationCoverageText"/>
                            <TextBlock Text="{Binding SelectedGroup.ConfidenceSummaryText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="CorrelationConfidenceSummaryText"/>
                        </StackPanel>
                        <TabControl Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="Correlation investigation views"
                                    AutomationProperties.AutomationId="CorrelationInvestigationTabs">
                            <TabItem Header="Timeline">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedGroup.Members}"
                                                  AutomationProperties.AutomationId="CorrelationTimelineList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CorrelationMemberViewModel}">
                                                <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DeltaText}" Style="{StaticResource MonoTextStyle}" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayEndpoint}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding RecordType}" Style="{StaticResource MonoTextStyle}" FontSize="11"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding PidText}" Style="{StaticResource MonoTextStyle}" FontSize="11"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding RepeatText}" Style="{StaticResource MonoTextStyle}" FontSize="11"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding SubjectDetailText}" Style="{StaticResource MonoTextStyle}" FontSize="11" TextWrapping="Wrap"
                                                                   ToolTip="{Binding SubjectDetailText}"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding JoinReasonText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap"/>
                                                        <Button Grid.Column="7" Content="Evidence" FontSize="10" Padding="6,2" Margin="6,0,0,0" Command="{Binding OpenEvidenceCommand}"
                                                                AutomationProperties.Name="{Binding DisplayEndpoint, StringFormat=Open evidence for {0}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Evidence Graph">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider Width="180" Minimum="0.5" Maximum="2" Value="{Binding GraphZoom}" TickFrequency="0.25"/>
                                        <TextBlock Text="  Nodes open exact retained evidence; edges show the engine join and confidence." Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Grid Width="{Binding GraphCanvasWidth}" Height="220" RenderTransformOrigin="0,0">
                                            <Grid.RenderTransform><ScaleTransform ScaleX="{Binding GraphZoom}" ScaleY="{Binding GraphZoom}"/></Grid.RenderTransform>
                                            <ItemsControl ItemsSource="{Binding GraphEdges}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" Opacity="{Binding StrokeOpacity}" ToolTip="{Binding ToolTip}"/>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding GraphNodes}" AutomationProperties.AutomationId="CorrelationGraphNodesList">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style></ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Button Width="{Binding Width}" Height="84" Content="{Binding Label}" Command="{Binding OpenEvidenceCommand}"
                                                            ToolTip="Open and validate this durable source record" Padding="10"
                                                            AutomationProperties.Name="{Binding Member.DisplayEndpoint, StringFormat=Correlation graph node: {0}}"/>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Chain View">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedGroup.Members}" AutomationProperties.AutomationId="CorrelationChainList">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CorrelationMemberViewModel}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource CardStyle}" Width="230" Margin="4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayEndpoint}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding RecordType}" Style="{StaticResource MonoTextStyle}" FontSize="11" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding DeltaText}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                                                            <TextBlock Text="{Binding SubjectDetailText}" Style="{StaticResource MonoTextStyle}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding JoinReasonText}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                            <Button Content="Open Evidence" Command="{Binding OpenEvidenceCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                                    AutomationProperties.Name="{Binding DisplayEndpoint, StringFormat=Open evidence for {0}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="→" FontSize="22" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Raw JSON">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding SelectedGroup.RawJson, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Correlation group raw JSON"
                                             AutomationProperties.AutomationId="CorrelationRawJsonTextBox"/>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
