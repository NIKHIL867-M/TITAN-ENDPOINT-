<Window x:Class="TitanEndpoint.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding EndpointName, StringFormat='{}{0} — Diagnostics'}"
        Width="900" Height="560" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBgBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="260" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="DiagnosticsFilterTextBox"
                     AutomationProperties.Name="Filter diagnostics"
                     ToolTip="Filter lines containing this text (case-insensitive)"/>
            <CheckBox Content="Errors only" IsChecked="{Binding ErrorsOnly}" Margin="12,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="DiagnosticsErrorsOnlyCheckBox"/>
            <CheckBox Content="Pause" IsChecked="{Binding IsPaused}" Margin="12,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="DiagnosticsPauseCheckBox"
                      AutomationProperties.HelpText="Pauses only this view -- capture never stops and no lines are lost while paused."
                      ToolTip="Pauses only this view -- capture never stops and no lines are lost while paused."/>
            <Button Content="Clear View" Command="{Binding ClearCommand}" Margin="16,0,0,0" Padding="8,3"
                    AutomationProperties.AutomationId="DiagnosticsClearViewButton"
                    AutomationProperties.HelpText="Clears this view only -- never deletes the endpoint's real evidence log."
                    ToolTip="Clears this view only -- never deletes the endpoint's real evidence log."/>
            <Button Content="Export..." Command="{Binding ExportCommand}" Margin="8,0,0,0" Padding="8,3"
                    AutomationProperties.AutomationId="DiagnosticsExportButton"/>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource SecondaryTextStyle}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="1">
            <ListView ItemsSource="{Binding Lines}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                      Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="DiagnosticsListView"
                      AutomationProperties.Name="Diagnostics lines">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding TimestampUtc, StringFormat='{}{0:HH:mm:ss.fff}'}"/>
                        <GridViewColumn Header="Level" Width="60" DisplayMemberBinding="{Binding Level}"/>
                        <GridViewColumn Header="Text" Width="680" DisplayMemberBinding="{Binding Text}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" TextWrapping="Wrap"
                   Text="Diagnostic output only — not the forensic JSONL evidence log, which the native collector writes independently of whether this panel is open."/>
    </Grid>
</Window>
