<UserControl x:Class="TitanEndpoint.App.Views.StixExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels"
             xmlns:ctl="clr-namespace:TitanEndpoint.App.Controls">
    <UserControl.DataContext>
        <vm:StixExportViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:EndpointHeader Grid.Row="0" Header="{Binding Header}"/>

        <!-- Santosh, 2026-08-27: "in the GUI it is nothing." The Convert card, Last Conversion
             Result, and new Send/Receive card were three Auto/Auto/* rows stacked with no outer
             scroll; on a window that isn't tall enough, the first two squeeze the new section
             down to almost no visible height, which looks exactly like "nothing is there." Wrapping
             the whole body in a ScrollViewer (same fix already used on Overview and other pages)
             guarantees the new section is always reachable regardless of window size. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,8">
            <StackPanel>
                <TextBlock Text="Correlated Logs to STIX" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Reads the Correlator's own correlated_events.json and converts every correlated incident that has a real observable (an IP address, a file with a real SHA-256, a process) into a STIX 2.1 Bundle -- the format OpenCTI (and most other threat-intel platforms) expects. Only 'observed-data' objects are written, never 'indicator' objects: TITAN records what it actually saw, it does not judge anything malicious -- that comparison is OpenCTI's job once you point it at this file. Nothing is sent over the network by this button; it only writes a file to disk, ready to hand to OpenCTI once it is set up."/>
                <TextBlock Text="{Binding SourceStatusText}" Style="{StaticResource MonoTextStyle}" FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                           AutomationProperties.AutomationId="StixSourceStatusText"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Convert to STIX" Command="{Binding ConvertCommand}" Padding="10,5"
                            AutomationProperties.AutomationId="ConvertToStixButton"
                            AutomationProperties.Name="Convert correlated logs to STIX 2.1 bundle"/>
                    <Button Content="Open Output Folder" Command="{Binding OpenOutputFolderCommand}" Padding="10,5" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="OpenStixOutputFolderButton"/>
                    <Button Content="Refresh" Command="{Binding RefreshStatusCommand}" Padding="10,5" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="RefreshStixStatusButton"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Last Conversion Result" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110">
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource MonoTextStyle}" FontSize="11.5" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="StixConversionResultText"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== SEND / RECEIVE (2-way exchange) =====================
             Santosh, 2026-08-27: "create a 2-way port in this application to send and receive
             information ... put the sender and receiver address in the same interface so I can see
             it clearly." Send: POSTs the last converted bundle to whatever address is entered below.
             Receive: TitanReportListener (an embedded HTTP listener) accepts a push back from
             whatever is on the other end; both directions share one token so neither side talks to
             the wrong thing, and the token is shown here in plain text specifically so it can be
             copied to the other machine's sender. -->
        <Border Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Send &amp; Receive (2-way exchange)" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="Send the last converted bundle to another machine (e.g. wherever OpenCTI is being set up), and receive a report pushed back from it whenever it's ready -- this does not wait for a synchronous reply."/>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Send to (their address):" VerticalAlignment="Center" Margin="0,0,10,6"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" Width="380"
                                 AutomationProperties.Name="Address to send the STIX bundle to"
                                 AutomationProperties.AutomationId="StixSendTargetUrlTextBox"/>
                        <Button Content="Send" Command="{Binding SendCommand}" Padding="10,5" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="StixSendButton"
                                AutomationProperties.Name="Send the last converted bundle to the address above"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Shared token (both sides must match):" VerticalAlignment="Center" Margin="0,0,10,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SharedToken, UpdateSourceTrigger=PropertyChanged}" Width="380" HorizontalAlignment="Left" Margin="0,0,0,6"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                             AutomationProperties.Name="Shared authentication token for send and receive"
                             AutomationProperties.AutomationId="StixSharedTokenTextBox"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Send result:" VerticalAlignment="Top" Margin="0,2,10,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SendResultText}" Style="{StaticResource MonoTextStyle}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="StixSendResultText"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Give this to the other machine:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ListenAddressText, Mode=OneWay}" IsReadOnly="True" HorizontalAlignment="Left" MinWidth="380"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                             AutomationProperties.Name="This machine's receive address, for the other side's sender"
                             AutomationProperties.AutomationId="StixListenAddressText"/>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="Received Reports" Style="{StaticResource SectionLabelStyle}" Margin="0,4,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ReceivedReports}" AutomationProperties.AutomationId="StixReceivedReportsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReceivedReportRowViewModel}">
                                <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="View Full" Command="{Binding ViewFullCommand}" Padding="6,2" FontSize="10" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="11">
                                                <Run Text="{Binding TimeText, Mode=OneWay}"/><Run Text="  from  "/><Run Text="{Binding RemoteAddress, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding BodyPreview}" Style="{StaticResource MonoTextStyle}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
