<UserControl x:Class="TitanEndpoint.App.Views.CustomRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels"
             xmlns:views="clr-namespace:TitanEndpoint.App.Views"
             xmlns:common="clr-namespace:TitanEndpoint.App.Common">
    <UserControl.DataContext>
        <vm:CustomRulesViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="WATCHER STATUS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="{Binding WatcherStatusText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="RESPONSE MODE" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="{Binding DryRunText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CUSTOM RULE" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Center"/>
                    <Button Content="{Binding CustomRuleToggleLabel}" Command="{Binding ToggleCustomRuleCommand}"
                            Margin="0,4,0,0" Padding="10,4" FontSize="11" MinWidth="150"
                            AutomationProperties.AutomationId="CustomRuleStartStopButton"
                            ToolTip="Starts or stops the Custom Rule API and watcher independently, without touching the native endpoints."/>
                    <TextBlock Text="{Binding CustomRuleActionStatus}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxWidth="220" AutomationProperties.AutomationId="CustomRuleActionStatusText"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Rule Authoring">
                <views:CustomRuleWizardView Margin="0,10,0,0"/>
            </TabItem>

            <TabItem Header="Watcher Coverage">
                <Grid Margin="0,10,0,0" DataContext="{Binding Coverage}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8">
                        Complete watcher capability map. Every known event, collector, availability state, collection mode, latency, and field count is visible together.
                    </TextBlock>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh Coverage" Command="{Binding RefreshCommand}" Padding="8,3"
                                AutomationProperties.AutomationId="RefreshCoverageButton"/>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" Margin="0,0,12,0"
                                 ToolTip="Filter by event, collector, status or reason"
                                 AutomationProperties.Name="Filter watcher coverage"
                                 AutomationProperties.AutomationId="WatcherCoverageFilterTextBox"/>
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              AutomationProperties.Name="Watcher coverage"
                              AutomationProperties.AutomationId="WatcherCoverageGrid"
                              common:LayoutPersistence.GridKey="WatcherCoverageGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Event / Watch Area" Binding="{Binding Event}" Width="220"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                            <DataGridTextColumn Header="Collector" Binding="{Binding Collectors}" Width="160"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
                            <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="70"/>
                            <DataGridTextColumn Header="Fields" Binding="{Binding FieldCount}" Width="60"/>
                            <DataGridTextColumn Header="Reason / Requirement" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,10,0,0" MaxHeight="200">
                        <TextBox Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <TextBlock Grid.Row="4" Text="{Binding StoragePolicyText}" Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" FontSize="10.5" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Approved Rules">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="1*" MinHeight="140"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshRulesCommand}" Padding="8,3"/>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" Margin="0,0,12,0"
                                 ToolTip="Filter by status, severity, trigger, response action or rule text"/>
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Promote to Knowledge" Command="{Binding PromoteSelectedCommand}" Padding="8,3"
                                AutomationProperties.AutomationId="PromoteRuleButton"/>
                        <Button Content="Delete Selected Rule" Command="{Binding DeleteSelectedCommand}" Padding="8,3" Margin="8,0,0,0"
                                Foreground="{StaticResource CriticalBrush}"
                                AutomationProperties.AutomationId="DeleteSelectedRuleButton"
                                AutomationProperties.HelpText="Destructive: permanently deletes the selected approved rule. Cannot be undone."/>
                        <Button Content="Delete Duplicate Records" Command="{Binding DeleteDuplicatesCommand}" Padding="8,3" Margin="8,0,0,0"
                                Foreground="{StaticResource CriticalBrush}"
                                AutomationProperties.AutomationId="DeleteDuplicateRulesButton"
                                AutomationProperties.HelpText="Destructive: permanently deletes duplicate approved-rule records, keeping the oldest copy. Cannot be undone."/>
                        <Button Content="Delete All Rules" Command="{Binding DeleteAllCommand}" Padding="8,3" Margin="8,0,0,0"
                                Foreground="{StaticResource CriticalBrush}"
                                AutomationProperties.AutomationId="DeleteAllRulesButton"
                                AutomationProperties.HelpText="Destructive: permanently deletes every approved rule. Cannot be undone."/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Rules}" AutoGenerateColumns="False"
                              SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                              AutomationProperties.Name="Approved rules"
                              AutomationProperties.AutomationId="ApprovedRulesGrid"
                              common:LayoutPersistence.GridKey="ApprovedRulesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="Trigger" Binding="{Binding TriggerEvent}" Width="130"/>
                            <DataGridTextColumn Header="Response" Binding="{Binding ResponseActions}" Width="120"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="140"/>
                            <DataGridTextColumn Header="Rule Text" Binding="{Binding RuleText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                        <TextBox Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <TextBlock Grid.Row="4" Text="{Binding ActionStatusText}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"/>
                </Grid>
            </TabItem>

            <TabItem Header="Watcher Activity">
                <Grid Margin="0,10,0,0" DataContext="{Binding Activity}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding InfoText}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh Once" Command="{Binding RefreshCommand}" Padding="8,3" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="RefreshActivityOnceButton"/>
                        <Button DockPanel.Dock="Right" Content="{Binding LiveButtonText}" Command="{Binding ToggleLiveCommand}" Padding="8,3"
                                AutomationProperties.Name="Toggle live watcher activity" AutomationProperties.AutomationId="ToggleLiveActivityButton"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="SAVE LOGS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <CheckBox IsChecked="{Binding SaveLogsEnabled}" Style="{DynamicResource ToggleSwitchStyle}"
                                      ToolTip="{Binding SaveLogsStatusText}"
                                      AutomationProperties.Name="Save watcher activity logs to disk"
                                      AutomationProperties.AutomationId="WatcherSaveLogsToggle"/>
                        </StackPanel>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"
                                 ToolTip="Filter by event, subject, rule ID, status or outcome"
                                 AutomationProperties.Name="Filter watcher activity"
                                 AutomationProperties.AutomationId="WatcherActivityFilterTextBox"/>
                    </DockPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                              AutomationProperties.Name="Watcher activity"
                              AutomationProperties.AutomationId="WatcherActivityGrid"
                              common:LayoutPersistence.GridKey="WatcherActivityGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ActivityRowViewModel}">
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="140"/>
                            <DataGridTextColumn Header="Process / Entity" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="90"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Matched Evidence &amp; Outcomes">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Matched Evidence + Response Outcomes" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxWidth="700">
                            These two workflows are unified as one searchable, filterable record on the
                            "Alerts &amp; Evidence" page in the left navigation — matched conditions, correlation
                            stages, durable evidence identity/integrity, action results (Alert/Kill/Isolate),
                            dry-run vs. live mode, and acknowledgement all live on that single row rather than
                            two separate tables that would otherwise show the same alert twice with different
                            controls. Open "Alerts &amp; Evidence" in the left navigation to search, filter, page
                            older alerts, and drill into full evidence or the originating rule.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
