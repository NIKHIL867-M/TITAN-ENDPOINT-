<Window x:Class="TitanEndpoint.App.Views.FollowStreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels"
        Title="{Binding ConversationTitle, StringFormat='{}Follow Stream — {0}'}"
        Width="900" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        AutomationProperties.AutomationId="FollowStreamWindow"
        AutomationProperties.Name="Follow TCP Stream">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="Auto"/>  <!-- notices -->
            <RowDefinition Height="*"/>     <!-- stream content -->
            <RowDefinition Height="Auto"/>  <!-- search bar -->
            <RowDefinition Height="Auto"/>  <!-- status -->
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">

            <!-- View mode -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Style="{StaticResource SecondaryTextStyle}"/>
                <RadioButton Content="Text"  GroupName="StreamViewMode" IsChecked="True"
                             AutomationProperties.AutomationId="FollowStreamTextModeRadio"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Checked="ViewMode_Checked" Tag="Text"/>
                <RadioButton Content="Hex"   GroupName="StreamViewMode"
                             AutomationProperties.AutomationId="FollowStreamHexModeRadio"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Checked="ViewMode_Checked" Tag="Hex"/>
                <RadioButton Content="ASCII" GroupName="StreamViewMode"
                             AutomationProperties.AutomationId="FollowStreamAsciiModeRadio"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Checked="ViewMode_Checked" Tag="Ascii"/>
                <RadioButton Content="Raw"   GroupName="StreamViewMode"
                             AutomationProperties.AutomationId="FollowStreamRawModeRadio"
                             VerticalAlignment="Center" Margin="0,0,16,0"
                             Checked="ViewMode_Checked" Tag="Raw"/>
            </StackPanel>

            <!-- Direction filter -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="Direction:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Style="{StaticResource SecondaryTextStyle}"/>
                <ComboBox AutomationProperties.AutomationId="FollowStreamDirectionCombo"
                          AutomationProperties.Name="Direction filter"
                          SelectedIndex="0" Width="90" VerticalAlignment="Center"
                          SelectionChanged="Direction_SelectionChanged">
                    <ComboBoxItem>Both</ComboBoxItem>
                    <ComboBoxItem>A → B</ComboBoxItem>
                    <ComboBoxItem>B → A</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <!-- Action buttons -->
            <Button DockPanel.Dock="Right" Content="Save…" Margin="8,0,0,0" Padding="10,4"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.AutomationId="FollowStreamSaveButton"
                    AutomationProperties.Name="Save stream to file"/>
            <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="10,4"
                    Command="{Binding CopyCommand}"
                    AutomationProperties.AutomationId="FollowStreamCopyButton"
                    AutomationProperties.Name="Copy stream text to clipboard"/>

            <!-- Stats -->
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource SecondaryTextStyle}" FontSize="11">
                <Run Text="{Binding PacketCount, Mode=OneWay, StringFormat='{}{0:N0} pkts'}"/>
                <Run Text=" | "/>
                <Run Text="{Binding GapCount, Mode=OneWay, StringFormat='{}gaps:{0}'}"/>
                <Run Text=" | "/>
                <Run Text="{Binding RetransmissionCount, Mode=OneWay, StringFormat='{}retx:{0}'}"/>
                <Run Text=" | "/>
                <Run Text="{Binding ExpiredCount, Mode=OneWay, StringFormat='{}expired:{0}'}"/>
            </TextBlock>
        </DockPanel>

        <!-- ===== Encrypted / privacy notice ===== -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6"
                Background="{StaticResource PanelBgBrush}"
                CornerRadius="4"
                Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding EncryptionNotice}"
                       Style="{StaticResource SecondaryTextStyle}"
                       FontSize="11" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="FollowStreamEncryptionNotice"/>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6"
                Background="{StaticResource PanelBgBrush}"
                CornerRadius="4"
                Visibility="{Binding Truncated, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Output stopped at the 1 MiB investigation limit. Export to file for full analysis."
                       Style="{StaticResource SecondaryTextStyle}"
                       FontSize="11" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="FollowStreamTruncatedNotice"/>
        </Border>

        <!-- ===== Stream content ===== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding RenderedText, Mode=OneWay}"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="11"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Top"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         AutomationProperties.AutomationId="FollowStreamContentTextBox"
                         AutomationProperties.Name="Stream content"/>
            </ScrollViewer>
        </Border>

        <!-- ===== Search bar ===== -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center"
                       Margin="0,0,6,0" Style="{StaticResource SecondaryTextStyle}"/>
            <TextBox DockPanel.Dock="Left" Width="260" VerticalContentAlignment="Center"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="FollowStreamSearchBox"
                     AutomationProperties.Name="Search stream content"
                     KeyDown="SearchBox_KeyDown"/>
            <Button DockPanel.Dock="Left" Content="▲ Prev" Padding="8,4" Margin="6,0,0,0"
                    Command="{Binding SearchPreviousCommand}"
                    AutomationProperties.AutomationId="FollowStreamSearchPrevButton"
                    AutomationProperties.Name="Search previous"/>
            <Button DockPanel.Dock="Left" Content="▼ Next" Padding="8,4" Margin="4,0,0,0"
                    Command="{Binding SearchNextCommand}"
                    AutomationProperties.AutomationId="FollowStreamSearchNextButton"
                    AutomationProperties.Name="Search next"/>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                       Text="{Binding SearchResultText}"
                       Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
        </DockPanel>

        <!-- ===== Status bar ===== -->
        <TextBlock Grid.Row="4" Margin="0,6,0,0"
                   Text="{Binding StatusText}"
                   Style="{StaticResource SecondaryTextStyle}"
                   FontSize="11" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="FollowStreamStatusText"/>
    </Grid>
</Window>
