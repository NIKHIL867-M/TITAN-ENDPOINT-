<UserControl x:Class="TitanEndpoint.App.Views.UnifiedLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels"
             xmlns:common="clr-namespace:TitanEndpoint.App.Common">
    <UserControl.DataContext>
        <vm:UnifiedLogsViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" HorizontalAlignment="Left" ToolTip="Filter by endpoint name"
                     AutomationProperties.Name="Filter log endpoints"
                     AutomationProperties.AutomationId="UnifiedLogsFilterTextBox"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DiskPressureText}" Style="{StaticResource SecondaryTextStyle}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="8" Margin="0,8,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox Content="All endpoints" IsChecked="{Binding QueryAllEndpoints}" VerticalAlignment="Center" Margin="0,0,10,0"
                              AutomationProperties.AutomationId="UnifiedLogsAllEndpointsCheckBox"/>
                    <TextBlock Text="From" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding QueryFromDate}" Width="125" AutomationProperties.AutomationId="UnifiedLogsFromDatePicker"/>
                    <TextBlock Text="To" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <DatePicker SelectedDate="{Binding QueryToDate}" Width="125" AutomationProperties.AutomationId="UnifiedLogsToDatePicker"/>
                    <TextBlock Text="Contains" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox Text="{Binding QuerySearchText, UpdateSourceTrigger=PropertyChanged}" Width="190"
                             ToolTip="Case-insensitive full-record search" AutomationProperties.AutomationId="UnifiedLogsQueryTextBox"/>
                    <TextBlock Text="Type/action" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox Text="{Binding QueryEventType, UpdateSourceTrigger=PropertyChanged}" Width="125"
                             ToolTip="Exact event_type, type, or action" AutomationProperties.AutomationId="UnifiedLogsEventTypeTextBox"/>
                    <TextBlock Text="Limit" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox Text="{Binding QueryMaxResults, UpdateSourceTrigger=PropertyChanged}" Width="58"
                             ToolTip="Interactive result bound: 1 to 10,000" AutomationProperties.AutomationId="UnifiedLogsResultLimitTextBox"/>
                    <Button Content="Search" Command="{Binding SearchQueryCommand}" Padding="9,3" Margin="8,0,0,0"
                            AutomationProperties.Name="Search retained endpoint evidence" AutomationProperties.AutomationId="UnifiedLogsSearchButton"/>
                    <Button Content="Export..." Command="{Binding ExportLogsCommand}" Padding="9,3" Margin="4,0,0,0"
                            AutomationProperties.Name="Export bounded retained evidence" AutomationProperties.AutomationId="UnifiedLogsExportButton"/>
                    <Button Content="Cancel" Command="{Binding CancelQueryCommand}" Padding="9,3" Margin="4,0,0,0"
                            AutomationProperties.Name="Cancel historical query or export" AutomationProperties.AutomationId="UnifiedLogsCancelButton"/>
                </WrapPanel>
            </Border>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False" SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}"
                  AutomationProperties.Name="Log catalog"
                  AutomationProperties.AutomationId="LogCatalogGrid"
                  common:LayoutPersistence.GridKey="LogCatalogGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointName}" Width="110"/>
                <DataGridTextColumn Header="Active File" Binding="{Binding ActiveFile}" Width="180"/>
                <DataGridTemplateColumn Header="Write State" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding WriteStateBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding WriteState}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Current Size" Binding="{Binding CurrentSize}" Width="90"/>
                <DataGridTextColumn Header="Total Retained" Binding="{Binding TotalSize}" Width="100"/>
                <DataGridTemplateColumn Header="Retained (graph)" Width="176">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Real "retained bytes by endpoint" bar graph, relative to the fleet
                                 max: the GUI-upgrade ask was "add any graph instead of that table".
                                 Kept as a column inside the existing functional table rather than
                                 replacing it, so no real capability (sort, filter, Open Folder,
                                 selection driving the history pane below) is lost. -->
                            <Border Width="160" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{StaticResource PanelBg2Brush}" CornerRadius="2">
                                <Border Width="{Binding BarWidthPixels}" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}" CornerRadius="2"
                                        ToolTip="{Binding TotalSize}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Records (session)" Binding="{Binding RecordCount}" Width="110"/>
                <DataGridTextColumn Header="Last Write" Binding="{Binding LastWrite}" Width="140"/>
                <DataGridTextColumn Header="Last Write Error" Binding="{Binding LastWriteError}" Width="160"/>
                <DataGridTextColumn Header="Directory" Binding="{Binding Directory}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open Folder" Padding="6,2" FontSize="11"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding EndpointName, StringFormat=Open log folder for {0}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush2}"
                      common:LayoutPersistence.SplitterKey="UnifiedLogs"/>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Reload newest" Command="{Binding LoadNewestCommand}" Padding="7,2"
                            AutomationProperties.Name="Reload newest log records" AutomationProperties.AutomationId="ReloadNewestLogsButton"/>
                    <Button Content="Load 100 older" Command="{Binding LoadOlderCommand}" Padding="7,2" Margin="6,0,0,0"
                            AutomationProperties.Name="Load 100 older log records" AutomationProperties.AutomationId="LoadOlderLogsButton"/>
                    <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource SecondaryTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding HistoryLines}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
