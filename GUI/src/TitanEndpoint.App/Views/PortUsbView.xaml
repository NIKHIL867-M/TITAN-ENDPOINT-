<UserControl x:Class="TitanEndpoint.App.Views.PortUsbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels"
             xmlns:ctl="clr-namespace:TitanEndpoint.App.Controls"
             xmlns:common="clr-namespace:TitanEndpoint.App.Common">
    <UserControl.DataContext>
        <vm:PortViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:EndpointHeader Grid.Row="0" Header="{Binding Header}"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8"
                Visibility="{Binding HasConnectionNotification, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissNotificationCommand}" Margin="12,0,0,0"
                        AutomationProperties.Name="Dismiss USB connection notification"
                        AutomationProperties.AutomationId="DismissUsbNotificationButton"/>
                <StackPanel>
                    <TextBlock Text="USB CONNECTION OBSERVED" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="{Binding ConnectionNotificationText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding ActiveDevices}" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="ActiveUsbDevicesList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UsbDeviceCardViewModel}">
                    <Border Style="{StaticResource CardStyle}" Width="240" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Device}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5"/>
                            <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,5,0,0">
                                <Run Text="{Binding VidPid}"/><Run Text="  "/><Run Text="{Binding MountPoint}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding ConnectedAt, StringFormat=Connected at {0}}" Style="{StaticResource SecondaryTextStyle}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <Run Text="Active sessions:"/><Run Text="{Binding ActiveSessionsText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="PortUsbSummaryText"/>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding RowsView.Count, StringFormat={}{0:N0} matching}"
                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding RowActions.LastResultText}"
                       Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"
                     ToolTip="Filter by event, device, VID:PID, mount point, manufacturer or detail"
                     AutomationProperties.Name="Filter Port/USB events"
                     AutomationProperties.AutomationId="PortUsbFilterTextBox"/>
        </DockPanel>

        <DataGrid x:Name="PortGrid" Grid.Row="5" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False"
                  AutomationProperties.Name="Port/USB events"
                  AutomationProperties.AutomationId="PortUsbEventsGrid"
                  common:LayoutPersistence.GridKey="PortUsbEventsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="200"/>
                <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="160"/>
                <DataGridTextColumn Header="VID:PID" Binding="{Binding VidPid}" Width="120"/>
                <DataGridTextColumn Header="Mount" Binding="{Binding MountPoint}" Width="80"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
            <!-- A USB device has no process to stop/isolate — only Open Location (the mount
                 point, when this row has one) is meaningful; RowActionsViewModel reports an honest
                 "no path available" for rows with none rather than hiding the menu inconsistently.
                 Menu is built in code-behind (RowActionsContextMenuHelper.Attach) — see that
                 helper's doc comment for why a declarative ContextMenu here silently no-ops. -->
        </DataGrid>
    </Grid>
</UserControl>
