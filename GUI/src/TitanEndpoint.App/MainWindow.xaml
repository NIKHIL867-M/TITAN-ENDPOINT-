<Window x:Class="TitanEndpoint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TitanEndpoint.App.ViewModels"
        Title="TITAN Endpoint" Height="860" Width="1440" WindowStartupLocation="CenterScreen"
        MinWidth="1100" MinHeight="640">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ===================== TOP COMMAND BAR ===================== -->
        <!-- FORU.TXT 0.4: "At 1366x768 and 125/150/200% scaling, the top command bar ... must wrap,
             collapse into labelled overflow, or switch to a two-row layout without clipping." The
             right-side WrapPanel (native WPF wrapping, not a manual breakpoint) drops onto a second
             line by itself once the window is too narrow for title + status + buttons on one row;
             the Auto-height row above lets the bar grow to fit that second line instead of clipping. -->
        <Border Grid.Row="0" Background="{StaticResource NavBgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" Opacity="0.35" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <WrapPanel Margin="16,10" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,4">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PageDescription}" Style="{StaticResource SecondaryTextStyle}"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Ellipse Width="9" Height="9" Fill="{Binding SystemStateBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SystemStateText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveEndpointsText}" Style="{StaticResource SecondaryTextStyle}"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LoggingText}" Style="{StaticResource SecondaryTextStyle}"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DiskBudgetText}" Style="{StaticResource SecondaryTextStyle}"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TopBarDiskBudgetText"/>
                    <Button Content="Preflight" Margin="18,0,0,0" Command="{Binding RunPreflightCommand}"
                            AutomationProperties.AutomationId="PreflightButton"
                            AutomationProperties.Name="Run preflight check"
                            AutomationProperties.HelpText="Verify executable hashes, Npcap, Python venv, admin rights, log-directory writability, and free disk space before Start All"
                            ToolTip="Verify executable hashes, Npcap, Python venv, admin rights, log-directory writability, and free disk space before Start All"/>
                    <Button Content="Start All" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding StartAllCommand}"
                            AutomationProperties.AutomationId="StartAllButton"
                            AutomationProperties.Name="Start all endpoints"/>
                    <Button Content="Stop All" Margin="8,0,0,0" Command="{Binding StopAllCommand}"
                            AutomationProperties.AutomationId="StopAllButton"
                            AutomationProperties.Name="Stop all endpoints"/>
                    <!-- Santosh, 2026-08-31: "just add button on dark and light... no restart for
                         that." One click saves the new theme and relaunches TITAN automatically
                         (App.RestartWithTheme), placed in the top bar, not buried in Settings, so it
                         is always one click away regardless of which page is open. -->
                    <Button Content="{Binding ThemeToggleLabel}" Margin="8,0,0,0" Command="{Binding ToggleThemeCommand}"
                            AutomationProperties.AutomationId="ToggleThemeButton"
                            AutomationProperties.Name="Toggle light or dark theme, restarts TITAN automatically"
                            ToolTip="Saves and relaunches TITAN with the other theme, no manual restart needed."/>
                    <TextBlock Text="{Binding ClockText}" Style="{StaticResource SecondaryTextStyle}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== LEFT NAVIGATION RAIL ===================== -->
            <!-- FORU.TXT 0.4: "The 12-item navigation rail must scroll, may collapse to labelled
                 icons, and must retain selection and focus." Below NavRailCollapseWidthThreshold
                 (MainWindow.xaml.cs) the column narrows and item labels hide via
                 NavLabelVisibility — IconGlyph and AutomationProperties.Name (still the full label,
                 not the glyph) stay unchanged, so a screen reader announces the real page name even
                 while collapsed. ScrollViewer.VerticalScrollBarVisibility="Auto" (default for
                 ListBox) already lets the 12-item list scroll rather than clip if the window is also
                 short. -->
            <Border Grid.Column="0" Background="{StaticResource NavBgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                        <TextBlock Text="TITAN" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding NavLabelVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <TextBlock Text="ENDPOINT" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Typography.Capitals="AllSmallCaps" FontWeight="SemiBold"
                                   Visibility="{Binding NavLabelVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <TextBlock Text="T" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                   Visibility="{Binding NavIconOnlyVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                             BorderThickness="0" Background="Transparent" Margin="8,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="PrimaryNavList"
                             AutomationProperties.Name="Primary navigation">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Page, StringFormat={}{0}}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- Santosh, 2026-08-27 redesign pass: selection previously read as a
                                                 background tint only, easy to miss at a glance. Added a flush-left
                                                 accent bar (via BorderThickness, not a separate element, so it can't
                                                 desync from the row) — the same "which page am I on" convention used
                                                 by VS Code's activity bar and most modern shell apps. -->
                                            <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0"
                                                    BorderBrush="Transparent" CornerRadius="0,6,6,0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrushSoft}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBg2Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                <Grid ToolTip="{Binding Label}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding NavLabelVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{Binding DotBrush}"
                                             Visibility="{Binding ShowDot, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===================== MAIN CONTENT ===================== -->
            <Grid Grid.Column="1" Background="{StaticResource WindowBgBrush}">
                <ContentControl x:Name="ContentHost" Margin="20"/>

                <!-- Start All / Stop All progress overlay -->
                <Border Background="#CC0F1113" Visibility="{Binding IsStartAllOverlayVisible, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardStyle}" Width="520" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Controller Actions" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,10"/>
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding StartAllRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StartAllRowViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="Retry" FontSize="10.5" Padding="6,2" Margin="0,0,4,0" Command="{Binding RetryCommand}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat=Retry {0}}"/>
                                                        <Button Content="Details" FontSize="10.5" Padding="6,2" Margin="0,0,4,0" Command="{Binding DetailsCommand}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat=Details for {0}}"/>
                                                        <Button Content="Copy" FontSize="10.5" Padding="6,2" Command="{Binding CopyErrorCommand}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat=Copy error for {0}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="Close" HorizontalAlignment="Right" Margin="0,14,0,0"
                                    Command="{Binding CloseOverlayCommand}"
                                    AutomationProperties.AutomationId="CloseControllerActionsButton"
                                    AutomationProperties.Name="Close controller actions"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Preflight check results overlay (FORU.TXT section 3) -->
                <Border Background="#CC0F1113" Visibility="{Binding IsPreflightOverlayVisible, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CardStyle}" Width="620" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Preflight Check" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PreflightSummaryText}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PreflightResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PreflightRowViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="Close" HorizontalAlignment="Right" Margin="0,14,0,0"
                                    Command="{Binding ClosePreflightOverlayCommand}"
                                    AutomationProperties.AutomationId="ClosePreflightResultsButton"
                                    AutomationProperties.Name="Close preflight results"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== BOTTOM STATUS BAR ===================== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="16,0">
                <TextBlock Text="{Binding ClockText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Text="•" Style="{StaticResource SecondaryTextStyle}" Margin="10,0" FontSize="11"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalAlignment="Center">
                    <Run Text="Rate:"/><Run Text="{Binding BottomRateText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="•" Style="{StaticResource SecondaryTextStyle}" Margin="10,0" FontSize="11"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalAlignment="Center">
                    <Run Text="Dropped:"/><Run Text="{Binding BottomDroppedText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="•" Style="{StaticResource SecondaryTextStyle}" Margin="10,0" FontSize="11"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalAlignment="Center">
                    <Run Text="Log:"/><Run Text="{Binding BottomLogPathText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="•" Style="{StaticResource SecondaryTextStyle}" Margin="10,0" FontSize="11"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalAlignment="Center">
                    <Run Text="Size:"/><Run Text="{Binding BottomLogSizeText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="•" Style="{StaticResource SecondaryTextStyle}" Margin="10,0" FontSize="11"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalAlignment="Center">
                    <Run Text="Last write:"/><Run Text="{Binding BottomLastWriteText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
