<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= Palette ================= Santosh, 2026-08-31: "add lightmode and
         darkmode option... should not change anything, only looks." The Color/Brush palette that
         used to live directly in this file (see git history / the 2026-08-13 neutral-palette pass
         this section replaces) now lives in Palette.xaml / PaletteLight.xaml instead. App.xaml.cs
         merges whichever one the user's saved preference selects, ahead of this file, at startup.
         Every style below still binds each resource by the exact same key name as always
         (WindowBgBrush, AccentBrush, HealthyBrush, ...); nothing in this file changed except that
         the palette values themselves moved one level out so they can be swapped as a unit. -->

    <!-- Santosh, 2026-08-27: "redesign the entire interface ... make the font more better, I want
         Times New Roman everywhere." UiFont drives every label, button, menu, tab, tooltip, and
         page title in the app (every consumer binds this one resource key, same convention as the
         palette above), so this single line puts Times New Roman on essentially all visible text.
         MonoFont deliberately stays a real monospace face: it is the font DataGrid data cells,
         hex/packet-byte dumps, and raw log tailing use specifically because a fixed-width face is
         what keeps their columns/bytes aligned — swapping it to a proportional serif would silently
         break that alignment, which is a functional regression, not a look-and-feel one. -->
    <FontFamily x:Key="UiFont">Times New Roman</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ================= Reduced Motion (FORU.TXT 0.4 last bullet) =================
         Every animation in this app must reference this Duration via DynamicResource, never a
         literal Duration — App.xaml.cs.ApplyReducedMotion() swaps this single resource to zero
         when Settings.ReducedMotion is on, which disables every animation that follows this
         convention in one place, globally, including ones added later. -->
    <Duration x:Key="MotionDuration">0:0:0.14</Duration>

    <!-- ================= Focus visuals (FORU.TXT 0.4: "visible focus") ================= -->
    <Style x:Key="TitanFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="2" Stroke="{StaticResource AccentBrush}"
                               StrokeDashArray="1 2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Control (not FrameworkElement) so this becomes every interactive element's implicit
         default; explicit per-type styles below (Button/TextBox/ComboBox/TabItem/CheckBox) also
         set it directly since an explicit TargetType style shadows this one rather than merging
         with it — belt-and-suspenders so keyboard focus is visible everywhere, not just on
         elements with no more-specific style. -->
    <Style TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
    </Style>

    <!-- ================= Base element styles ================= -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBgBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{StaticResource WindowBgBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Santosh, 2026-08-27: "text that is in black color, I just wanted it to be in white." Found
         via pixel sampling, not just looking: this style never set Foreground, and (unlike an
         unstyled TextBlock, which correctly inherits TextPrimaryBrush from the Window) applying ANY
         named Style with no Foreground setter does not fall through to the inherited value here;
         it rendered at effectively the same RGB as the panel background (measured (32,32,36) against
         a (29,29,32) background), i.e. real but functionally invisible text. This is the single
         shared style behind ~30 usages across Process/Network/Correlation/Applications/Files/
         StixExport/Overview (PIDs, hashes, paths, IPs, command lines), all of them, not just the
         one row the ask pointed at, so the fix belongs here, once, rather than at each call site. -->
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelBg2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrushSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
        <Setter Property="Foreground" Value="#FF0A0A0C"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- Faint accent-tinted glow instead of a plain black card shadow — the primary CTA (Start
             All) should visibly read as "the important button" at a glance, not just via color. -->
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource AccentColor}" Opacity="0.45" BlurRadius="12" ShadowDepth="0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Toggle switch (Monitoring / Save Logs) =================
         Two variants, not one dynamically-durationed one: a Storyboard used inside a
         ControlTemplate.Triggers gets sealed (frozen) the first time the style is applied, and WPF
         cannot freeze a Timeline that contains a DynamicResource reference — that combination
         throws "Cannot freeze this Storyboard timeline tree for use across threads" the first time
         any page with this style loads (found empirically 2026-08-02: it broke navigation to every
         endpoint page silently — the nav title updated but the page content never did, because the
         XamlParseException it caused was swallowed by MainWindow.Navigate's caller). Reduced Motion
         is therefore implemented by swapping which STYLE resource "ToggleSwitchStyle" points to
         (App.ApplyReducedMotion, below) rather than by parameterizing the animation inside it —
         Setters (Style="{DynamicResource ...}") support DynamicResource safely; Storyboards do not. -->
    <Style x:Key="ToggleSwitchStyleAnimated" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                Background="{StaticResource PanelBg2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"/>
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource HealthyBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="18" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reduced Motion variant: the thumb jumps to its final position via a plain Setter instead of
         an animated Storyboard — otherwise pixel-identical to ToggleSwitchStyleAnimated. -->
    <Style x:Key="ToggleSwitchStyleInstant" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                Background="{StaticResource PanelBg2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"/>
                        <!-- No RenderTransform here (unlike the Animated variant) — a plain Margin
                             is a directly-settable FrameworkElement property a Trigger Setter can
                             target by name with no PropertyPath, which ControlTemplate.Triggers
                             Setters do not support for nested Freezable properties. -->
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource HealthyBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="21,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Defensive default so {DynamicResource ToggleSwitchStyle} always resolves even before
         App.OnStartup's ApplyReducedMotion call runs (e.g. design-time) — overwritten at runtime. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyleAnimated}"/>

    <!-- ================= Cards / panels =================
         Santosh, 2026-08-27 redesign pass: cards previously had zero elevation (border only), which
         is a big part of why the app read as flat/administrative rather than a considered product —
         every reference app worth copying (Defender, Falcon, Windows 11 Settings) gives its cards a
         soft drop shadow so they visibly sit above the window background. CornerRadius bumped 6->8
         to match ContextMenu's existing 8, so cards/menus/overlays now share one "large surface"
         radius instead of two slightly different ones. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF000000" Opacity="0.30" BlurRadius="14" ShadowDepth="3" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FORU.TXT 0.4: "compact/comfortable table-density modes." Comfortable defaults; swapped by
         TableDensityManager (mutates the dictionary entries in place, which DynamicResource
         consumers below pick up immediately) rather than two parallel style sets. -->
    <sys:Double x:Key="TableRowHeight">24</sys:Double>
    <Thickness x:Key="TableCellPadding">6,2</Thickness>

    <!-- ================= DataGrid ================= -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource AlternateRowBgBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="{DynamicResource TableRowHeight}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PanelBg2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- Previously had no IsMouseOver trigger at all, so rows gave zero feedback while scanning a
         table with the mouse: the exact "not interactive/fluent enough" gap flagged from a real
         screenshot review of the Process/Network event tables. Kept clearly weaker than the
         IsSelected accent so hover never gets confused with an actual selection. -->
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBgBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrushSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{DynamicResource TableCellPadding}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= ContextMenu / MenuItem (row action menus) =================
         Flat, dark, no submenu/icon/checkbox support — every use in this app is a short flat list
         of leaf actions (Open Location / Stop / Isolate), so a lightweight retemplate is enough;
         without this the default WPF popup renders bright white, which would be a visible
         regression against the rest of this app's layered graphite theme.

         Santosh, 2026-08-04: "that box UI is not good" (the Process/Files/Applications/Port/USB
         row action popup) — widened, rounded, given real depth (a raised card, not a flat system
         menu strip), and destructive actions (Stop/Isolate) now read visibly differently from safe
         ones (Open Location) via DestructiveMenuItemStyle below, rather than every row looking
         identical regardless of consequence. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource PanelBg2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF000000" Opacity="0.45" BlurRadius="16" ShadowDepth="4" Direction="270"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaseMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrushSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource BaseMenuItemStyle}"/>

    <!-- For Stop / Isolate specifically — a real, hard-to-reverse action deserves to visibly read
         differently from Open Location before the click, not just at the confirmation dialog. -->
    <Style x:Key="DestructiveMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource BaseMenuItemStyle}">
        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CriticalBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
    </Style>

    <!-- ================= ScrollBar (thin, monochrome, dark-theme-aware) =================
         Santosh, 2026-08-27 redesign pass: this style previously set only Background/Width, so the
         actual track/thumb/arrows still came from the default OS ScrollBar template — bright,
         theme-unaware chrome rendered on top of an otherwise fully dark app, on every scrollable
         page (DataGrids, log views, nav rail). Same fix pattern already applied to
         Button/ComboBox/ContextMenu above: a full custom ControlTemplate is the only reliable way
         to actually reach WPF's default chrome. -->
    <Style x:Key="TitanScrollBarThumb" TargetType="Thumb">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd" Background="{StaticResource BorderBrush2}" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitanScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TitanScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource TitanScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TitanScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Width/Height set per-orientation, not both unconditionally: an unconditional Height
                 setter would clamp vertical scrollbars (which need to stretch to fill their column)
                 to a fixed 10px, same reasoning as everywhere else stretch vs. fixed-size matters. -->
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= ComboBox / TextBox ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource PanelBg2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Found live via a real screenshot review: plain Setters (Background/Foreground/BorderBrush)
         do not reliably reach WPF's default ComboBox chrome, and specifically never reach the
         PART_EditableTextBox part an IsEditable="True" ComboBox uses (Network's display filter box):
         that part supplies its own white background from the OS theme regardless of outer Setters.
         A full custom ControlTemplate is the only reliable fix, same reason Button already has one
         above. Also gives every ComboBox in the app (editable or not) real hover/focus cues,
         matching the "make it interactable" ask. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource PanelBg2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Bd" Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True"/>
                        <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                 Style="{x:Null}"
                                 Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 BorderThickness="0" Margin="{TemplateBinding Padding}"
                                 VerticalAlignment="Center" Focusable="True" Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        <ToggleButton x:Name="ToggleButton" Grid.Column="1"
                                      Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextSecondaryBrush}"
                                              StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource PanelBg2Brush}" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBgBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrushSoft}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrushSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keep stock WPF collection/date controls inside the TITAN palette. Without these implicit
         styles, the OS theme supplies white content wells (most visibly in Unified Logs history
         and Network's nested investigation tabs), which breaks contrast and visual hierarchy. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrushSoft}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                                  Background="Transparent" Margin="4,2,4,0"
                                  KeyboardNavigation.TabIndex="1"/>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Santosh, 2026-08-27: "wherever text color is black, turn it into white." DatePicker's
         internal text entry is a DatePickerTextBox, a distinct WPF type from TextBox with its own
         hard-coded default template; our global TextBox style and the plain Setters below never
         reached it, so both the "Select a date" watermark and a typed date rendered in WPF's stock
         near-black default text on our dark background (invisible/near-invisible), the exact same
         "plain Setters don't reach WPF's default chrome" issue already fixed for ComboBox above.
         Retemplating this one internal type (not DatePicker itself) is enough: WPF's own default
         DatePicker template instantiates DatePickerTextBox for its PART_TextBox, so this implicit,
         type-targeted style reaches it without needing to touch DatePicker's outer chrome at all.
         The calendar drop-down popup itself still uses the OS default (light) styling; retheming
         Calendar's day/month grid is a separate, larger job nobody's asked for; this fixes the text
         that is visible at all times without opening the popup. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <!-- DatePickerTextBox toggles PART_Watermark's visibility itself via
                             VisualStateManager (Watermarked/Unwatermarked in "WatermarkStates"),
                             not a Trigger: these two empty-bodied states are required for that
                             built-in logic to find somewhere to go; the Watermarked VisualState's
                             Storyboard is what actually flips Visibility. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="WatermarkStates">
                                <VisualState x:Name="Unwatermarked"/>
                                <VisualState x:Name="Watermarked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBox x:Name="PART_TextBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"/>
                        <!-- DatePickerTextBox has no public bindable "Watermark" DependencyProperty
                             in this WPF version (TemplateBinding to one fails to compile); the
                             built-in default template hardcodes its watermark text the same way. -->
                        <ContentControl x:Name="PART_Watermark"
                                        Content="Select a date"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource PanelBg2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelBg2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,5"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TitanFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                        </Trigger>
                        <!-- Unselected tabs previously gave zero feedback on hover, unlike every
                             other interactive element in this app (buttons/rows/nav items all
                             brighten under the mouse) — same treatment here for consistency. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
