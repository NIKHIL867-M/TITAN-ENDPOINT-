# ── AI Understanding Layer v5 — Environment Configuration ──
# Copy this file to .env and fill in your Groq API key.
# NEVER commit .env to version control.

# ── Layer 2: Rule authoring API ──────────────────────────────
GROQ_API_KEY=your_api_key_here
# Once set above, run `python scripts/migrate_secret_to_dpapi.py` once to move
# this key into Windows-DPAPI-encrypted local storage (tied to this Windows
# user account) and blank it from this plaintext file automatically. This
# folder is OneDrive-synced; DPAPI keeps the encrypted copy safe to sync
# because it's undecryptable without also being logged in as this Windows
# user. See shared/secret_store.py.
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b
PORT=3000
ENV=development

# API authentication: desktop.py's native launcher sets GEKKO_API_TOKEN
# automatically per-launch (do not set it here). A standalone
# `uvicorn app.main:app` launch has no token by default and now FAILS CLOSED
# (returns 503 on /api/*) unless you explicitly opt in below.
# GEKKO_ALLOW_UNAUTHENTICATED_LOCAL=true

# Authoring-time local retrieval. The watcher never loads this index.
RAG_ENABLED=true
RAG_SHADOW_MODE=false
RAG_MAX_DOCUMENTS=7
RAG_MAX_CONTEXT_CHARS=12000
RAG_MIN_SCORE=0.22
MAX_RULE_LENGTH=4000
# Bound each structured LLM response to keep authoring memory/cost predictable.
MAX_LLM_OUTPUT_TOKENS=4096

# ── Watcher Agent (Layers 4-8) ───────────────────────────────

# SAFETY: Keep this true until you've validated your rules in dry-run mode.
# When true, kill_process and isolate_host are LOGGED but NOT executed.
# Set to false only after watching rules run correctly in dry-run.
WATCHER_DRY_RUN=true

# Telemetry collectors to enable (comma-separated).
# Options: security (needs admin), system, sysmon (optional), wmi,
# registry_fim, inventory, powershell, scheduled_tasks, usb, firewall, defender,
# titan_sensors (tails the 5 TITAN ENDPOINT native sensors + the Correlator).
# Remove collectors whose prerequisites aren't met to avoid startup alerts.
# NOTE: If both 'security' and 'wmi' are enabled, both can produce
# process.start events for the same real process. A dedup guard ensures
# only the first event within a 2-second window is matched — no double
# alerts, no double actions. titan_sensors can likewise double up with
# sysmon/security/wmi on process.start/file.create/etc — same dedup guard.
WATCHER_COLLECTORS=system,wmi,registry_fim,inventory,titan_sensors

# titan_sensors: where to find the 5 TITAN ENDPOINT sensors' log directories
# and the Correlator's own config/output. Defaults assume this CUSTOM RULE
# folder and the TITAN ENDPOINT C++ programs share the same parent directory
# (as shipped). Override only if you relocate one relative to the other.
# TITAN_CORRELATOR_CONFIG=..\CORRELATOR\correlator_config.txt
# TITAN_CORRELATOR_LOG_DIR=..\CORRELATOR\out\build\x64-Debug\bin\logs

# Agent-wide circuit breaker: max kill/isolate actions per minute.
# Prevents a miscalibrated rule from taking down the box in a loop.
WATCHER_MAX_DESTRUCTIVE_PER_MINUTE=5

# Delete evidence files older than this many days.
WATCHER_EVIDENCE_RETENTION_DAYS=30
WATCHER_EVIDENCE_MAX_FILES=10000
WATCHER_EVIDENCE_MAX_TOTAL_MB=1024

# Rotate alerts.jsonl at WATCHER_ALERT_MAX_BYTES and retain this many archives.
WATCHER_ALERT_MAX_BYTES=5000000
WATCHER_ALERT_ARCHIVES=4

# Logging verbosity for the watcher process.
WATCHER_LOG_LEVEL=INFO
